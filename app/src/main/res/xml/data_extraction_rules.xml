<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only favourites, playlists, history (Room) and settings (DataStore). Caches,
     crash logs and the read-only 1.x database are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mtplayer.db" />
        <include domain="database" path="mtplayer.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mtplayer.db" />
        <include domain="database" path="mtplayer.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
