<?xml version="1.0" encoding="utf-8"?>
<!-- Backup & device-transfer rules for Android 12+. Updater state is device-specific. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mt_updater.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mt_updater.xml" />
    </device-transfer>
</data-extraction-rules>
