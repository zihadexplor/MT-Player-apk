<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mtplayer.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="crash" />
        <exclude domain="database" path="melody_player_local.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mtplayer.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="crash" />
    </device-transfer>
</data-extraction-rules>
